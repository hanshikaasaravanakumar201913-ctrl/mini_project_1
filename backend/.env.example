# Medora Environment Configuration Example
# Copy to backend/.env and customize before production deployment.

PROJECT_NAME="Medora Multilingual Smart Medicine Management"
VERSION="2.0.0"
ENVIRONMENT="development"

# Database URL (defaults to root SQLite medora.db if omitted; supports PostgreSQL/Supabase)
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DATABASE_URL=""

# Security & Session Signing (CHANGE IN PRODUCTION! Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=""
SESSION_TTL_HOURS=72
ALLOW_DEV_FALLBACK_AUTH=false

# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Academic C99 Shared Library Path (optional override)
C_LIB_PATH=""

# Private Prescription Storage Directory (relative to project root or absolute)
PRIVATE_UPLOAD_DIR="backend/private_uploads"
MAX_UPLOAD_SIZE_MB=10

# Optional External Adapters (Leave blank to use built-in development adapters)
TESSERACT_CMD=""
OPENCAGE_API_KEY=""
GEOCODING_PROVIDER="auto"
NOMINATIM_USER_AGENT="MedoraHealthPlatform/2.0 (academic-pharmacy-discovery)"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Optional Provider-Independent Controlled LLM Integration
# Supports: disabled (default deterministic fallback), openai_compatible
LLM_PROVIDER="disabled"
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SEC=8.0
